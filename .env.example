# ---------------------------------------------------------------------------
# Admin Authentication
# ---------------------------------------------------------------------------
ADMIN_USERNAME=vcet-nsdc
ADMIN_PASSWORD=AIDS@2026
ADMIN_SESSION_SECRET=techx-uncharted-expedition-super-secure-session-key-2026

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Paste the SRV connection string from Atlas. Two things matter for the free
# tier: keep the database name in the path, and do NOT append your own
# maxPoolSize — src/lib/mongodb.ts sets a deliberately small pool so that
# many concurrent Vercel lambdas stay under M0's 500-connection ceiling.
#
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# In Atlas -> Network Access, allow 0.0.0.0/0: Vercel functions do not have
# stable outbound IPs, so an allowlist of specific addresses will lock the
# app out mid-event.
MONGODB_URI=
DB_NAME=uncharted-expedition

# ---------------------------------------------------------------------------
# Operational switches
# ---------------------------------------------------------------------------
# Index creation on every serverless cold start is wasted work against a
# shared-CPU M0. Run `npm run db:setup` once before the event, then set this
# to false in the Vercel production environment.
AUTO_DB_SETUP=false

# Inserts the fictional demo explorers (Nathan Drake et al.) into an empty
# database. MUST stay false in production or they appear on the live
# leaderboard alongside real attendees.
SEED_DEMO_DATA=false
